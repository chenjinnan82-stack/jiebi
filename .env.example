# Server only. Existing Ollama remains the default; no silent provider fallback.
SKETCH_PROVIDER=ollama
# To use the verified NVIDIA vision model, set SKETCH_PROVIDER=nebius.
NEBIUS_API_KEY=
# Persistent total project allowance in USD. This release never permits more than $1.
NEBIUS_BUDGET_USD=1.00
# Keep development + unknown holds below $0.50. Never reset the existing usage database.
NEBIUS_PHASE=development
# Hosted review only, after following deploy/README.md. Never put these in the extension.
# JIEBI_PUBLIC_URL=https://sanliang.online/jiebi
# JIEBI_REVIEW_TOKEN=<a random secret of at least 32 characters>
# JIEBI_TEST_TOKEN=<a different random test-only secret>
# Optional, separately authorized Grok Bot testing. See BOT_SKILL.md.
# GROK_WEBHOOK_URL=https://...
# GROK_WEBHOOK_KEY=
# JIEBI_EXTERNAL_SECRET=<a random secret of at least 32 characters>
