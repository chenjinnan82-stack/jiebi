[Unit]
Description=Jiebi paper handoff
After=network-online.target

[Service]
User=jiebi
Group=jiebi
WorkingDirectory=/opt/jiebi/current
Environment=PYTHONUNBUFFERED=1
Environment=SKETCH_PORT=5332
ExecStart=/opt/jiebi/venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:5332 --timeout 90 --access-logfile - --error-logfile - study:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jiebi/shared
MemoryMax=384M
TasksMax=24
CPUQuota=100%

[Install]
WantedBy=multi-user.target
